{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sentry": {
    "Dsn": ""
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "PhotosPermitLimit": 20,
    "PhotosWindowSeconds": 60,
    "ContentWritesPermitLimit": 30,
    "ContentWritesWindowSeconds": 60,
    "ReportsPermitLimit": 5,
    "ReportsWindowSeconds": 300
  }
}
